# Copy this file to .env. Do not commit .env.
# The current MVP does not require an API key or secret.

CAMERA_INDEX=0
MIN_HAND_DETECTION_CONFIDENCE=0.60
MIN_TRACKING_CONFIDENCE=0.60
GESTURE_COOLDOWN_MS=800
# A held static scroll pose repeats at this interval.
SCROLL_COOLDOWN_MS=60
# Small, frequent wheel steps avoid large page jumps.
SCROLL_AMOUNT=1
# Hold a recognized open palm this long to arm/reset controls.
OPEN_PALM_HOLD_MS=120
# Directional poses must remain inside the stillness radius for this long.
DIRECTION_SETTLE_MS=220
# Maximum fingertip movement during settling, measured in palm widths.
DIRECTION_STILLNESS_RADIUS=0.10
ACTIONS_ENABLED=false

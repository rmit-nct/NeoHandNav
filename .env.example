# Copy this file to .env. Do not commit .env.
# The current MVP does not require an API key or secret.

CAMERA_INDEX=0
MIN_HAND_DETECTION_CONFIDENCE=0.60
MIN_TRACKING_CONFIDENCE=0.60
GESTURE_COOLDOWN_MS=800
# A held static scroll pose repeats at this interval.
SCROLL_COOLDOWN_MS=60
# Small, frequent wheel steps avoid large page jumps.
SCROLL_AMOUNT=1
# Hold a recognized open palm this long to arm/reset controls.
OPEN_PALM_HOLD_MS=120
# Directional poses must remain inside the stillness radius for this long.
DIRECTION_SETTLE_MS=220
# Maximum fingertip movement during settling, measured in palm widths.
DIRECTION_STILLNESS_RADIUS=0.10
ACTIONS_ENABLED=false
# Mouse mode: point then add middle finger to click; palm then two fingers to scroll/arrows.
# Navigation mode: the original open-palm gate without pointer movement.
CONTROL_MODE=mouse
# Browser toolbar Back/Forward by default. Use slides for plain Left/Right.
NAVIGATION_TARGET=browser
# Camera border excluded from pointer mapping (0 to less than 0.45).
POINTER_MARGIN=0.15
# Lower cutoff = less jitter; higher coefficient = faster response to movement.
POINTER_MIN_CUTOFF=1.5
POINTER_SPEED_COEFFICIENT=6.0
# Buffer pointing motion to discard gesture-transition shake (0-250 ms).
POINTER_BUFFER_MS=100
# Ignore tiny filtered movements around the visible cursor (0-10 screen pixels).
POINTER_DEADZONE_PX=2
# Hold thumbs-up this long for a double click; release to point sooner for single.
DOUBLE_CLICK_HOLD_MS=900
# Hold a recognized fist this long for one playback toggle in Mouse mode.
FIST_HOLD_MS=600
# Optional override: playpause (Windows default), space (other platforms), or k.
# PLAY_PAUSE_KEY=playpause
